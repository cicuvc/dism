+ x,delta=sample(n,'hard','vary');x[7].zero_();x[8].zero_();x[-1].fill_(2.)
+ delta[:,:,::32]=torch.inf;delta[:,:,1::32]=0.
+ gpu=[torch.cat([a,a],0).cuda() if i!=11 else a.cuda() for i,a in enumerate(x)]
+ dg=torch.cat([delta,delta*.25],0).cuda()
