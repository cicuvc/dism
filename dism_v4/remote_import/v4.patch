+        if length:
+            out,ref=oracle(sliced(x,start,length),delta[:,:,start:start+length],do[:,start:start+length])
+            expected.append(out)
+            for key,value in ref.items():refs.setdefault(key,[]).append(value)
+        start+=length
+    names=('q_vec','k_vec','sq_vec','sk_vec','v','q_lse','k_lse','rtau','delta')
+    if n==0:
