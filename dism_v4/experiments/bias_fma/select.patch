+// Select compact vector elements without duplicating the score finalization
+// loop for the two directions or broadcasting bias into an accumulator tile.
+template <class Score, class QIndex, class KIndex,
+          class QBias, class KBias>
+__device__ __forceinline__ void finish_score_fma(
+    Score &score, const QIndex &q_labels, const KIndex &k_labels,
+    const QBias &q_bias2, const KBias &k_bias2, uint32_t hard_rows,
+    float tau2, int q_start, int k_start, bool query_lse) {
+    int lane = kt::warp::laneid();
+#pragma unroll
+    for (int rb = 0; rb < score.height; ++rb) {
+#pragma unroll
+        for (int cb = 0; cb < score.width; ++cb) {
+#pragma unroll
+            for (int rh = 0; rh < 2; ++rh) {
+                int row = q_start + rb * 16 + rh * 8 + lane / 4;
+                uint32_t hard = (hard_rows >> (rb * 2 + rh)) & 1;
+                int label = rh ? q_labels.data[rb][0].y : q_labels.data[rb][0].x;
+#pragma unroll
+                for (int ch = 0; ch < 2; ++ch) {
+                    float2 bias;
+                    float q_bias = rh ? q_bias2.data[rb][0].y : q_bias2.data[rb][0].x;
+                    auto k_bias = k_bias2.data[cb][ch];
+                    asm("slct.f32.s32 %0, %2, %3, %5;\n"
+                        "slct.f32.s32 %1, %2, %4, %5;"
+                        : "=&f"(bias.x), "=&f"(bias.y)
+                        : "f"(q_bias), "f"(k_bias.x), "f"(k_bias.y),
+                          "r"(query_lse ? 0 : -1));
+                    auto &value = score.tiles[rb][cb].data[rh + 2 * ch];
+                    auto labels = k_labels.data[cb][ch];
+                    int col = k_start + 2 * cb + ch + 16 * (lane & 3);
+                    finish_score_pair(value, hard, label, labels.x, labels.y,
+                                      tau2, row, col, bias.x, bias.y);
+                }
+            }
+        }
+    }
+}
