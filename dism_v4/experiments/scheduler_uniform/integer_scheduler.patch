+// Host-prepared exact unsigned division. The floor reciprocal underestimates
+// the quotient by at most one; the remainder comparison supplies that one.
+// Saturating the reciprocal also handles divisor=1 without a device branch.
+struct SummaryTaskDivisor {
+    uint32_t divisor, reciprocal;
+
+    __host__ explicit SummaryTaskDivisor(uint32_t value = 1)
+        : divisor(value), reciprocal(uint32_t(std::min(
+              (uint64_t(1) << 32) / value, uint64_t(UINT32_MAX)))) {}
+
+    __device__ __forceinline__ uint32_t divide(uint32_t value) const {
+        uint32_t quotient = __umulhi(value, reciprocal);
+        return quotient + (value - quotient * divisor >= divisor);
+    }
+};
