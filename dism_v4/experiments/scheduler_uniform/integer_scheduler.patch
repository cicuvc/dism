diff --git a/src/scheduler_probe.cu b/src/scheduler_probe.cu
new file mode 100644
index 0000000..a0a8401
--- /dev/null
+++ b/src/scheduler_probe.cu
@@ -0,0 +1,23 @@
+#include "summary/primitives.cuh"
+
+__global__ void task_divisor_probe_kernel(const int64_t *values, int64_t *output,
+                                         int count, SummaryTaskDivisor divisor) {
+    int index = blockIdx.x * blockDim.x + threadIdx.x;
+    if (index < count) output[index] = divisor.divide(uint32_t(values[index]));
+}
+
+at::Tensor task_divisor_probe_cuda(at::Tensor values, int64_t divisor) {
+    TORCH_CHECK(values.is_cuda() && values.scalar_type() == at::kLong &&
+                    values.is_contiguous() && values.numel() > 0 &&
+                    values.numel() <= INT32_MAX,
+                "expected nonempty contiguous CUDA int64 values");
+    TORCH_CHECK(divisor > 0 && divisor <= UINT32_MAX, "invalid divisor");
+    c10::cuda::CUDAGuard guard(values.device());
+    auto output = at::empty_like(values);
+    task_divisor_probe_kernel<<<(values.numel() + 255) / 256, 256, 0,
+                                at::cuda::getCurrentCUDAStream()>>>(
+        values.data_ptr<int64_t>(), output.data_ptr<int64_t>(), int(values.numel()),
+        SummaryTaskDivisor(uint32_t(divisor)));
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+    return output;
+}
diff --git a/tests/test_scheduler.py b/tests/test_scheduler.py
new file mode 100644
index 0000000..88cdb2c
--- /dev/null
+++ b/tests/test_scheduler.py
@@ -0,0 +1,30 @@
+"""Exact scheduler division, including values beyond production task counts."""
+import pytest
+import torch
+import cu_flash_dism
+from test_summary import make_inputs, summarize_inputs
+
+
+@pytest.mark.parametrize('divisor', [1, 2, 3, 7, 16, 31, 112, 255, 256, 257,
+                                     65535, 65536, 65537, 2**31-1, 2**31,
+                                     2**32-1])
+def test_task_divisor(divisor):
+    generator = torch.Generator().manual_seed(712)
+    random = torch.randint(0, 2**32, (10000,), generator=generator)
+    edges = {0, 1, 2**32-1}
+    for quotient in [1, 2, 3, 17, (2**32-1)//divisor]:
+        for delta in [-1, 0, 1]:
+            value = quotient * divisor + delta
+            if 0 <= value < 2**32:
+                edges.add(value)
+    values = torch.cat((random, torch.tensor(sorted(edges)))).cuda()
+    got = cu_flash_dism.task_divisor_probe(values, divisor)
+    torch.testing.assert_close(got, values // divisor, atol=0, rtol=0)
+
+
+@pytest.mark.parametrize('n', [769, 2048])
+@pytest.mark.parametrize('ctas', [5, 17, 64])
+def test_scheduler_stride(n, ctas):
+    inputs = make_inputs(n, 'mixed', 'mixed')
+    torch.testing.assert_close(summarize_inputs(inputs, ctas=ctas),
+                               summarize_inputs(inputs, ctas=1), atol=0, rtol=0)
